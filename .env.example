# ----------------------------------------------------------------------------
# 1. CẤU HÌNH SUPABASE (Supabase Dashboard -> Project Settings -> API)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# 2. CẤU HÌNH TÀI KHOẢN KÝ QUỸ BAN QUẢN TRỊ (MB BANK)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_BANK_CODE=MB
NEXT_PUBLIC_ADMIN_BANK_NAME=MB Bank (Quan Doi)
NEXT_PUBLIC_ADMIN_ACCOUNT_NO=07440948327598
NEXT_PUBLIC_ADMIN_ACCOUNT_NAME=TRAN QUOC THIEN PHUOC
NEXT_PUBLIC_FIXED_DEPOSIT_AMOUNT=200000

# ----------------------------------------------------------------------------
# 3. CẤU HÌNH TELEGRAM BOT ALERT
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_DEFAULT_CHAT_ID=your-telegram-chat-id

# ----------------------------------------------------------------------------
# 4. CẤU HÌNH TÊN MIỀN ỨNG DỤNG
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
